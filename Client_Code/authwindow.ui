  <property name="styleSheet">
   <string notr="true">*
{
    font-family: &quot;Microsoft YaHei&quot;;
}
QPushButton
{
background-color: #07c160; 
color: white; 
border: none; 
border-radius: 8px;
font-size: 14px;
font-weight: bold; 
}

QPushButton#btnBack
{
	background-color: transparent; 
	border-image: url(:/image/return.png);
}

QLineEdit 
{
    background-color: #FFFFFF;
    color: rgb(30, 30, 30);
    border: 1px solid rgb(225, 230, 234);
    border-radius: 5px;
    padding: 5px 8px;  /* 比QComboBox稍宽的内边距 */
    min-height: 15px;
    selection-background-color: rgb(70, 130, 200);  /* 选中文本背景色 */
    selection-color: white;  /* 选中文本颜色 */
}


QCheckBox {
    spacing: 5px;
    padding: 3px 0;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid rgb(225, 230, 234);
    border-radius: 3px;
    background-color: white;
}

QCheckBox::indicator:hover {
    border-color: rgb(210, 215, 220);
}

QCheckBox::indicator:checked {
    image: url(:/image/check.png);
}

QPushButton#btnSwitchRegister,#btnSwitchLogin
{
	background-color: transparent; 
	 color: rgb(30, 30, 30);
}

</string>
