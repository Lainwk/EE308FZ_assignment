  <property name="styleSheet">
   <string notr="true">*
{
    font-family: &quot;Microsoft YaHei&quot;;
    font-size: 12px;
    color: rgb(30, 30, 30); /* 主文字色 */
}
QPushButton
{
background-color: #07c160; 
color: white; 
border: none; 
border-radius: 8px;
font-size: 14px;
font-weight: bold; 
}

QPushButton:hover { background-color: #06ad56; }

QFrame#frameHomeTitle
{
	background-color: rgb(255, 255, 255);
	border-top-left-radius:12px;
	border-top-right-radius:12px;
}
QFrame#frameSets
{
	background-color: rgb(244, 245, 246);
		border-top-left-radius:12px;
	border-top-right-radius:12px;
}

QFrame#frameSet
{
	background-color: rgb(255, 255, 255);
}

QGroupBox 
{
    border: 1px solid rgb(225, 230, 234);
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.7);
}

QCheckBox {
    spacing: 5px;
    padding: 3px 0;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid rgb(225, 230, 234);
    border-radius: 3px;
    background-color: white;
}

QCheckBox::indicator:hover {
    border-color: rgb(210, 215, 220);
}

QCheckBox::indicator:checked {
    image: url(:/image/check.png);
}
QLabel#labelAvatar
{
	border: none; 
	border-image:url(:/head_portrait/head_portrait/0.png);
}
QLabel#labelLogo
{
	border-image:url(:/image/logo.png);
}
</string>
